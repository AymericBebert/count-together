{
  "name": "count-together",
  "version": "1.0.0",
  "description": "Count Together SPA/PWA",
  "repository": {
    "type": "git",
    "url": "https://github.com/AymericBebert/count-together"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "build:serve": "ng build && npx http-server -p 4500 -c-1 dist/count-together/browser",
    "build:dev": "ng build --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "extract": "ngx-translate-extract --input './src/**/!(*.spec).{html,ts}' --output ./src/assets/i18n/{en,fr}.json --clean --sort --format namespaced-json --format-indentation '  ' --string-as-default-value 'MISSING_TRANSLATION'"
  },
  "author": "Aymeric BERNARD",
  "license": "MIT",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@ngx-translate/core": "^18.0.0",
    "d3": "~7.9.0",
    "rxjs": "~7.8.2",
    "socket.io-client": "~4.8.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@eslint/js": "~10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/d3": "~7.4.3",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vendure/ngx-translate-extract": "^10.3.1",
    "angular-eslint": "22.6.0",
    "eslint": "~10.13.0",
    "jsdom": "^30.1.3",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
